# Django
SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True

# Dominios y seguridad del navegador
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.test
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEXES=^http://.*\.localhost:3000$,^http://.*\.test:3000$
CORS_ALLOW_CREDENTIALS=True

# Empresa usada al abrir el frontend directamente en localhost durante desarrollo
LOCAL_DEFAULT_EMPRESA_SLUG=Analiza

# Base de datos principal - Supabase PostgreSQL
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=0

# Base de datos heredada - solo migraciones controladas
LEGACY_DATABASE_URL=

# Autenticacion JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_SESSION_MAX_HOURS=5
JWT_REMEMBER_ME_DAYS=30
JWT_REFRESH_COOKIE_NAME=ventas_refresh
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Strict

# Superusuario de despliegue
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Correo transaccional - Brevo API HTTPS
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT=15
DEFAULT_FROM_EMAIL=Sistema de Ventas <REMITENTE_VERIFICADO_EN_BREVO>

# Archivos multimedia - Cloudflare R2
# Manten desactivado R2 hasta configurar todas sus variables.
R2_STORAGE_ENABLED=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_REGION_NAME=auto

# Pagos
PAGOS_PROVEEDOR_DEFAULT=simulado
PAGOS_WEBHOOK_SECRET=

# Prefacturas para pago en sucursal
PREFACTURA_VIGENCIA_HORAS=72
PREFACTURA_MAX_INTENTOS_CORREO=4

# Versiones legales aceptadas durante el registro
TERMINOS_VERSION_ACTUAL=2026-08-13
PRIVACIDAD_VERSION_ACTUAL=2026-08-13

# Docker y Gunicorn
DOCKER_PORT=8000
DJANGO_COLLECTSTATIC=True
DJANGO_RUN_MIGRATIONS=True
DJANGO_ENSURE_SUPERUSER=False
DOCKER_HEALTHCHECK_HOST=localhost
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
