SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.test
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEXES=^http://.*\.localhost:3000$,^http://.*\.test:3000$
CORS_ALLOW_CREDENTIALS=True
DATABASE_URL=sqlite:///db.sqlite3

# Cloudflare R2 media storage. Keep disabled until all values are configured.
R2_STORAGE_ENABLED=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_REGION_NAME=auto

JWT_ACCESS_TOKEN_MINUTES=15
JWT_SESSION_MAX_HOURS=5
JWT_REFRESH_COOKIE_NAME=ventas_refresh
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Strict

# Deployment bootstrap. Set real secrets only in the hosting environment.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Brevo SMTP email settings. Do not commit real credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sistema de Ventas <no-reply@example.com>

# Neutral payment foundation. Replace the provider and secret in production.
PAGOS_PROVEEDOR_DEFAULT=simulado
PAGOS_WEBHOOK_SECRET=

# PostgreSQL replacement example for Render or Supabase:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
